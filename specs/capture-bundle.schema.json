{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capture Bundle v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "mode",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "region-recording",
        "window-recording",
        "display-recording",
        "screenshot"
      ]
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "instruction": {
      "type": "string"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
